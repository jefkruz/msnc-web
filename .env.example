VITE_APP_NAME=MSNC Recruitment

# Leave VITE_API_URL EMPTY to route /api, /sanctum, /storage through the Vite
# dev proxy to https://api.missionsupportnetworkcenter.org (no CORS issues).
VITE_API_URL=

# If you run the local msnc-api, point the dev proxy at it instead:
# VITE_API_URL=http://localhost:8000

# Production build: use .env.production
# VITE_API_URL=https://api.missionsupportnetworkcenter.org
